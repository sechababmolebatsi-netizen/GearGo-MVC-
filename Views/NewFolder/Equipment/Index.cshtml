@model IEnumerable<GearGo.Models.Equipment>

@{
    ViewData["Title"] = "Equipment Catalogue";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🛠️ GearGo Rental Catalogue</h2>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped border shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Item Name</th>
                    <th>Category</th>
                    <th>Daily Rate</th>
                    <th>Availability</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td><strong>@item.Name</strong></td>
                        <td><span class="badge bg-secondary">@item.Category</span></td>
                        <td>R @item.DailyRate.ToString("F2")</td>
                        <td>
                            @if (item.IsAvailable)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Rented / Maintenance</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
