@model GearGo.Models.Equipment

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white p-3">
            <h3 class="mb-0"> Asset Specifications: @Model.Name</h3>
        </div>
        <div class="card-body p-4">
            <dl class="row">
                <dt class="col-sm-3 text-muted">Category Class</dt>
                <dd class="col-sm-9"><span class="badge bg-info text-dark">@Model.Category</span></dd>

                <dt class="col-sm-3 text-muted">Item Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3 text-muted">Daily Hire Cost</dt>
                <dd class="col-sm-9 text-success fw-bold">R @Model.DailyRate.ToString("F2")</dd>

                <dt class="col-sm-3 text-muted">Inventory Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsAvailable)
                    {
                        <span class="badge bg-success">Ready for Booking</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Currently Checked Out</span>
                    }
                </dd>
            </dl>
        </div>
        <div class="card-footer bg-light p-3 d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary"> Back to Catalogue</a>
            @if (Model.IsAvailable)
            {
                <button class="btn btn-success" onclick="alert('Rental Request submitted successfully!')">
                    Submit Rental Request
                </button>
            }
            else
            {
                <button class="btn btn-secondary" disabled>Item Unavailable</button>
            }
        </div>
    </div>
</div>
